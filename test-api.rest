### AttendMate API Tests (REST Client Extension)
### Use this file with VS Code REST Client extension

@baseUrl = http://localhost:5000/api
@token = YOUR_TOKEN_HERE

### ========== HEALTH CHECK ==========
GET http://localhost:5000/api/health

### ========== AUTH ==========

### Register HR User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Your HR Name",
  "email": "your-hr@example.com",
  "password": "your-password",
  "role": "hr"
}

### Register Employee
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Employee Name",
  "email": "employee@example.com",
  "password": "your-password",
  "role": "employee"
}

### Login HR User
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "your-hr@example.com",
  "password": "your-password"
}

### Login Employee
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "employee@example.com",
  "password": "your-password"
}

### Get Current User
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### ========== EMPLOYEES ==========

### Employee Login (App)
POST {{baseUrl}}/employees/login
Content-Type: application/json

{
  "email": "employee@example.com",
  "password": "your-password"
}

### Get Employee Profile (App)
GET {{baseUrl}}/employees/profile
Authorization: Bearer {{token}}

### Add Employee (HR)
POST {{baseUrl}}/employees/add
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Employee Name",
  "employeeId": "YOUR_EMP_ID",
  "email": "employee@example.com",
  "phone": "1234567890",
  "department": "Department Name",
  "designation": "Designation",
  "password": "employee-password",
  "salary": 50000,
  "joiningDate": "2024-01-01",
  "address": "Employee Address"
}


### Get All Employees
GET {{baseUrl}}/employees
Authorization: Bearer {{token}}

### Get Employee by Custom ID
GET {{baseUrl}}/employees/find/YOUR_EMP_ID
Authorization: Bearer {{token}}

### Get Employee by MongoDB ID (replace with actual ID)
GET {{baseUrl}}/employees/675048c8e8f9a1234567890a
Authorization: Bearer {{token}}

### Update Employee (HR)
PUT {{baseUrl}}/employees/EMPLOYEE_MONGO_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "department": "Updated Department",
  "salary": 55000
}

### Delete Employee (HR)
DELETE {{baseUrl}}/employees/EMPLOYEE_MONGO_ID
Authorization: Bearer {{token}}

### ========== ATTENDANCE ==========

### Check-In
POST {{baseUrl}}/attendance/check-in
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "employeeId": "YOUR_EMP_ID",
  "date": "2024-12-08",
  "time": "09:30:00"
}

### Check-Out
POST {{baseUrl}}/attendance/check-out
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "employeeId": "YOUR_EMP_ID",
  "date": "2024-12-08",
  "time": "18:00:00"
}

### Get All Attendance
GET {{baseUrl}}/attendance
Authorization: Bearer {{token}}

### Get Attendance by Date
GET {{baseUrl}}/attendance?date=2024-12-08
Authorization: Bearer {{token}}

### Get Attendance by Employee
GET {{baseUrl}}/attendance/YOUR_EMP_ID
Authorization: Bearer {{token}}

### Get Attendance by Employee with Date Range
GET {{baseUrl}}/attendance/YOUR_EMP_ID?from=2024-12-01&to=2024-12-31
Authorization: Bearer {{token}}

### ========== LEAVES ==========

### Request Leave
POST {{baseUrl}}/leaves/request
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "employeeId": "YOUR_EMP_ID",
  "leaveType": "Sick Leave",
  "fromDate": "2024-12-10",
  "toDate": "2024-12-12",
  "reason": "Your reason"
}

### Get All Leaves (HR)
GET {{baseUrl}}/leaves
Authorization: Bearer {{token}}

### Get Leaves by Employee
GET {{baseUrl}}/leaves/employee/YOUR_EMP_ID
Authorization: Bearer {{token}}

### Approve/Reject Leave (HR)
PUT {{baseUrl}}/leaves/LEAVE_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "Approved"
}

### ========== EVENTS ==========

### Add Event (HR)
POST {{baseUrl}}/events/add
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Event Title",
  "start": "2024-12-10T10:00:00",
  "end": "2024-12-10T11:00:00",
  "description": "Event description",
  "allDay": false,
  "type": "Meeting"
}


### Get All Events
GET {{baseUrl}}/events
Authorization: Bearer {{token}}

### Update Event (HR)
PUT {{baseUrl}}/events/EVENT_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated Event Title",
  "description": "Updated description"
}

### Delete Event (HR)
DELETE {{baseUrl}}/events/EVENT_ID
Authorization: Bearer {{token}}
